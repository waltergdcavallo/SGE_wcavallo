{% extends 'frontend/layout.html.twig' %}


{% block title %}Bienvenidos a la Plataforma de Eventos{% endblock %}

{% block body %}
    <div class="container my-4">

        <div class="p-5 mb-5 bg-light rounded-4 shadow-sm border position-relative overflow-hidden">
            <div class="container-fluid py-3">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-rocket-takeoff-fill me-1"></i> Bienvenidos a la plataforma
                        </span>
                        <h1 class="display-5 fw-bold text-dark mt-2">
                            Inscríbete a tus eventos de forma <span class="text-primary">fácil y rápida</span>
                        </h1>
                        <p class="fs-5 text-muted mt-3">
                            Explora todos los eventos disponibles, inscríbete y mantén el control de tus actividades desde un solo lugar. ¡Inicia sesión para comenzar!
                        </p>

                        <div class="d-flex flex-wrap gap-3 mt-4">
                            <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg px-4 shadow-sm rounded-pill">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                            </a>
                            <a href="{# {{ path('app_register') }} #}#" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                                <i class="bi bi-person-plus me-2"></i> Registrarme
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-4 text-center d-none d-lg-block">
                        <div class="p-4 bg-white rounded-circle shadow-sm d-inline-block border">
                            <i class="bi bi-calendar-event text-primary display-1 px-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% for mensaje in app.flashes('info') %}
            <div class="alert alert-info alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ mensaje }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div> 
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-grid-fill text-primary me-2"></i> Symfony 7.4 - Próximos Eventos
                </h2>
                <p class="text-muted mb-0">Explora las actividades disponibles y participa.</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 g-4 mb-5">

            <div class="col">
                <div class="d-flex flex-column gap-3">
                    {% for evento in eventosCol1 %}
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                            <div class="card-body">
                                {% include 'evento/_card.html.twig' %}
                            </div>
                        </div>
                    {% else %}
                        <div class="card border-0 shadow-sm rounded-4 bg-light text-center py-5">
                            <div class="card-body text-muted">
                                <i class="bi bi-calendar-x display-5 text-secondary mb-2 d-block"></i>
                                <p class="mb-0">No hay eventos disponibles en esta sección.</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col">
                <div class="d-flex flex-column gap-3">
                    {% for evento in eventosCol2 %}
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                            <div class="card-body">
                                {% include 'evento/_card.html.twig' %}
                            </div>
                        </div>
                    {% else %}
                        <div class="card border-0 shadow-sm rounded-4 bg-light text-center py-5">
                            <div class="card-body text-muted">
                                <i class="bi bi-calendar-x display-5 text-secondary mb-2 d-block"></i>
                                <p class="mb-0">No hay eventos disponibles en esta sección.</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>

    </div>
{% endblock %}