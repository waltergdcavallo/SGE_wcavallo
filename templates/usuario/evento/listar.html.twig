{% extends 'usuario/layout-usuario.html.twig' %}

{% block title %}
    Listado de eventos
{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i> Mis Eventos e Inscripciones
            </h1>
            <p class="text-muted mb-0">
                Consulta los eventos en los que estás participando y revisa sus horarios.
            </p>
        </div>
    </div>

    {% block messages %}
        {{ parent() }}
    {% endblock %}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary fw-bold">
                        <tr>
                            <th class="ps-4">Fecha / Hora</th>
                            <th>Título del Evento</th>
                            <th>Idioma</th>
                            <th>Disertante</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for evento in eventos %}
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-calendar3 text-muted me-1"></i> {{ evento.fecha|date('d/m/Y') }}
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock text-muted me-1"></i> {{ evento.hora|date('H:i') }}
                                    </small>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">{{ evento.titulo }}</span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        {{ evento.idioma }}
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        <i class="bi bi-person me-1"></i> {{ evento.disertante ?? 'A confirmar' }}
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('usuario_evento_ver', {id: evento.id}) }}" 
                                           class="btn btn-outline-primary btn-sm rounded-pill px-3" 
                                           title="Ver detalles">
                                            <i class="bi bi-eye me-1"></i> Ver detalle
                                        </a>
                                        <a href="#" class="btn btn-outline-success btn-sm rounded-pill px-3">Inscribirse</a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted py-4">
                                        <i class="bi bi-calendar-x display-4 text-secondary mb-3 d-block"></i>
                                        <h5 class="fw-semibold text-dark">Aún no estás inscripto en ningún evento</h5>
                                        <p class="small text-muted mb-3">Explora la lista de eventos disponibles y apúntate a los que te interesen.</p>
                                        <a href="{{ path('app_eventos') }}" class="btn btn-primary btn-sm rounded-pill px-4">
                                            Ver eventos disponibles
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}