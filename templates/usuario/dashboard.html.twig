{% extends 'usuario/layout-usuario.html.twig' %}

{% block title %}Mi Sitio{% endblock %}

{% block body %}
    <div class="p-5 mb-4 bg-light rounded-4 shadow-sm border">
        <div class="container-fluid py-4">
            
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-star-fill"></i> Panel Principal
                    </span>
                    <h1 class="display-5 fw-bold text-dark mt-2">
                        ¡Qué bueno verte de nuevo!
                    </h1>
                    <p class="fs-5 text-muted mt-3">
                        Este es tu espacio central. Desde aquí puedes supervisar la actividad reciente, gestionar tus eventos y acceder rápidamente a las herramientas de administración.
                    </p>
                    
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="{{ path('usuario_evento_listar') }}" class="btn btn-primary btn-lg px-4 shadow-sm">
                            <i class="bi bi-calendar-check me-2"></i> Explorar Eventos
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="bi bi-gear me-2"></i> Mi Perfil
                        </a>
                    </div>
                </div>
                
                <div class="col-lg-4 text-center d-none d-lg-block">
                    <div class="p-3 bg-white rounded-circle shadow-sm d-inline-block border">
                        <i class="bi bi-speedometer2 text-primary display-1 px-3"></i>
                    </div>
                </div>
            </div>
    
        </div>
    </div>
{% endblock %}