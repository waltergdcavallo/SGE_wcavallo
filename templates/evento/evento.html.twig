{% extends 'base.html.twig' %}

{% block title %}Hello EventoController!{% endblock %}

{% block body %}

<h1>{{ evento.titulo }}</h1>

<p>{{ evento.descripcion }}</p>

<div>
    <strong>Fecha:</strong>
    {{ evento.fecha|date('d/m/Y') }}
</div>

<div>
    <strong>Hora:</strong>
    {{ evento.hora|date('H:i') }}
    -
    {# evento.horaFinalizacion|date('H:i') falta esto #} 
</div>

<div>
    <strong>Idioma:</strong>
    {{ evento.idioma }}
</div>

<div>
    <strong>Disertante:</strong>
    {{ evento.disertante }}
</div>

{% endblock %}
