{% extends 'frontend/layout.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block body %}

    <h1>Eventos</h1>

    {% for evento in eventos %}

    <div>
        <strong>
            {{ evento.hora|date('H:i')}}
            -
            {{ evento.horaFinalizacion|date('H:i')}}
        </strong>

        <br>

        {% include 'evento/_card.html.twig'%}
    </div>
    {% endfor %}
{% endblock %}