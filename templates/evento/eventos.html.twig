{% extends 'base.html.twig' %}

{% block title %}Hello EventoController!{% endblock %}

{% block body %}

    <h1>Eventos</h1>

    {% for evento in eventos %}

    <div>

        <a href="{{ path('evento_detalle', {'slug': evento.slug}) }}">
            {{ evento.titulo }}
        </a>

        <strong>
            {{ evento.hora|date('H:i')}}
            -
            {{ evento.horaFinalizacion|date('H:i')}}
        </strong>

        <br>
        
        <p>{{ evento.descripcion}}</p>
    </div>
    {% endfor %}
{% endblock %}