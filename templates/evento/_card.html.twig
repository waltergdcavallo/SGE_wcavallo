{% extends 'base.html.twig' %}

{% block body %}
<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white transition-hover">
    
    <div class="card-body d-flex flex-column p-4">
        
        <h3 class="h5 fw-bold mb-2">
            <a href="{{ path('evento_detalle', {'slug': evento.slug}) }}" class="text-decoration-none text-dark stretched-link">
                {{ evento.titulo|title }}
            </a>
        </h3>
        <p class="text-muted small mb-4 flex-grow-1">
            {{ evento.descripcion|slice(0, 150) }}
        </p>

        <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
            <span class="small text-primary fw-semibold">
                <i class="bi bi-calendar-event me-1"></i> Ver detalles
            </span>
            <i class="bi bi-arrow-right text-primary"></i>
        </div>

    </div>
</div>
{% endblock %}