{% extends 'admin/layout-admin.html.twig' %}

{% block title %}
    Gestión de Eventos
{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-event text-primary me-2"></i> Gestión de Eventos
            </h1>
            <p class="text-muted mb-0">
                Administra los eventos programados, revisa los inscriptos y controla su estado.
            </p>
        </div>
        <div>
            <a href="{{ path('admin_evento_nuevo') }}" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> Nuevo Evento
            </a>
        </div>
    </div>

    {% block messages %}
        {{ parent() }}
    {% endblock %}

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary fw-bold">
                        <tr>
                            <th class="ps-4">Fecha / Hora</th>
                            <th>Título</th>
                            <th>Idioma</th>
                            <th>Inscriptos</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for evento in eventos %}
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-calendar3 text-muted me-1"></i> {{ evento.fecha|date('d/m/Y') }}
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock text-muted me-1"></i> {{ evento.hora|date('H:i') }}
                                    </small>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">{{ evento.titulo }}</span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        {{ evento.idioma }}
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-people-fill me-1"></i> {{ evento.usuarios|length }}
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-success bg-opacity-15 px-3 py-2 rounded-pill">
                                        {{ evento.estado }}
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_evento_inscriptos', {id: evento.id}) }}" 
                                           class="btn btn-outline-info btn-sm rounded-pill px-3" 
                                           title="Ver Inscriptos">
                                            <i class="bi bi-person-lines-fill me-1"></i> Inscriptos
                                        </a>

                                        <a href="{{ path('admin_evento_ver', {id: evento.id}) }}" 
                                           class="btn btn-outline-info btn-sm rounded-pill px-3" 
                                           title="Ver detalles">
                                            <i class="bi bi-eye me-1"></i> Ver
                                        </a>

                                        <form action="{{ path('admin_evento_borrar', {id: evento.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar este evento?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Borrar Evento">
                                                <i class="bi bi-trash me-1"></i> Borrar
                                            </button>
                                        </form>
                                    </div>
                                    
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted py-4">
                                        <i class="bi bi-calendar-x display-4 text-secondary mb-3 d-block"></i>
                                        <h5 class="fw-semibold text-dark">No hay eventos registrados</h5>
                                        <p class="small text-muted mb-3">Comienza creando tu primer evento en la plataforma.</p>
                                        <a href="{{ path('admin_evento_nuevo') }}" class="btn btn-primary btn-sm rounded-pill px-4">
                                            Crear nuevo evento
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}