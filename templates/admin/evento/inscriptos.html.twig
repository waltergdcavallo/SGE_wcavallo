{% extends 'admin/layout-admin.html.twig' %}

{% block title %}Inscriptos al Evento{% endblock %}

{% block body %}
    <div class="container mt-4 mb-5">
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom gap-3">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-people-fill text-info me-2"></i> Inscriptos al Evento
                </h1>
                <p class="text-muted mb-0">
                    Listado detallado de los usuarios registrados en este evento.
                </p>
            </div>
            <div>
                <a href="{{ path('admin_evento_listar') }}" class="btn btn-outline-secondary px-4 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i> Volver a Eventos
                </a>
            </div>
        </div>
    
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-info border-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-info bg-opacity-10 text-info px-3 py-1 rounded-pill mb-2 fw-semibold">
                        <i class="bi bi-translate me-1"></i> Idioma: {{ evento.idioma }}
                    </span>
                    <h3 class="fw-bold text-dark mb-0">{{ evento.titulo }}</h3>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="d-inline-block bg-light px-4 py-3 rounded-4 text-center border">
                        <span class="d-block text-muted small text-uppercase fw-bold">Total Inscriptos</span>
                        <span class="fs-4 fw-bold text-primary">{{ evento.usuarios|length }}</span>
                    </div>
                </div>
            </div>
        </div>
    
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 text-secondary fw-bold">
                            <tr>
                                <th class="ps-4" style="width: 60px;">#</th>
                                <th>DNI</th>
                                <th>Nombre y Apellido</th>
                                <th>Teléfono</th>
                                <th class="pe-4">Correo Electrónico</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for usuario in evento.usuarios %}
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">
                                        {{ loop.index }}
                                    </td>
    
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">
                                            {{ usuario.dni|default('No registrado') }}
                                        </span>
                                    </td>
    
                                    <td>
                                        <div class="fw-bold text-dark">
                                            {{ usuario.nombre }} {{ usuario.apellido }}
                                        </div>
                                    </td>
    
                                    <td>
                                        <span class="text-muted small">
                                            <i class="bi bi-telephone text-muted me-1"></i> {{ usuario.telefono|default('Sin teléfono') }}
                                        </span>
                                    </td>
    
                                    <td class="pe-4">
                                        <span class="text-muted small">
                                            <i class="bi bi-envelope text-muted me-1"></i> {{ usuario.email }}
                                        </span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted py-4">
                                            <i class="bi bi-person-slash display-4 text-secondary mb-3 d-block"></i>
                                            <h5 class="fw-semibold text-dark">No hay usuarios inscriptos</h5>
                                            <p class="small text-muted mb-0">Aún no se ha registrado ningún usuario para este evento.</p>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    
    </div>
{% endblock %}