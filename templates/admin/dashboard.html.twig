{% extends 'admin/layout-admin.html.twig' %}

{% block title %}Panel Administrador{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i> Panel de Administración
            </h1>
            <p class="text-muted mb-0">Bienvenido de nuevo</p>
        </div>
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                <i class="bi bi-shield-check me-1"></i> Administrador
            </span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-primary border-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary bg-opacity-15 text-primary p-3 rounded-3 fs-3">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 text-uppercase fs-7 fw-bold">Eventos Totales</h6>
                        <h3 class="fw-bold mb-0 text-dark">5</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-success border-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-success bg-opacity-15 text-success p-3 rounded-3 fs-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 text-uppercase fs-7 fw-bold">Disertantes</h6>
                        <h3 class="fw-bold mb-0 text-dark">4</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-warning bg-opacity-15 text-warning p-3 rounded-3 fs-3">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="text-muted mb-1 text-uppercase fs-7 fw-bold">Usuarios</h6>
                        <h3 class="fw-bold mb-0 text-dark">34</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h4 class="fw-bold text-dark mb-3">Accesos Rápidos</h4>
    <div class="row g-4">
        
        <div class="col-md-4">
            <div class="card h-150 border-0 shadow-sm rounded-4 p-4 text-center hover-card bg-light">
                <div class="card-body">
                    <div class="text-primary display-5 mb-3">
                        <i class="bi bi-calendar-plus"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Gestionar Eventos</h5>
                    <p class="text-muted small mb-3">Crea, edita o elimina los eventos programados en la plataforma.</p>
                    <a href="{{ path('admin_evento_listar') }}" class="btn btn-outline-primary rounded-pill px-4">
                        Ver Eventos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-150 border-0 shadow-sm rounded-4 p-4 text-center hover-card bg-light">
                <div class="card-body">
                    <div class="text-success display-5 mb-3">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Gestionar Disertantes</h5>
                    <p class="text-muted small mb-3">Administra el listado de oradores y profesionales invitados.</p>
                    <a href="{{ path('admin_disertante_listar') }}" class="btn btn-outline-success rounded-pill px-4">
                        Ver Disertantes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-150 border-0 shadow-sm rounded-4 p-4 text-center hover-card bg-light">
                <div class="card-body">
                    <div class="text-warning display-5 mb-3">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Configuración</h5>
                    <p class="text-muted small mb-3">Revisa los parámetros generales y la seguridad del sistema.</p>
                    <a href="#" class="btn btn-outline-dark rounded-pill px-4">
                        Ajustes
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
{% endblock %}