{% extends 'base.html.twig' %}

    {% block header %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3 mb-4 rounded-3">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" href="{{ path('admin_dashboard') }}">
                    <i class="bi bi-shield-lock-fill text-primary"></i> 
                    <span>Panel de Administrador</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar" aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link active px-3 rounded-pill" href="{{ path('admin_dashboard') }}">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" href="{{ path('admin_evento_listar') }}">
                                <i class="bi bi-calendar-event me-1"></i> Eventos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill" href="{{ path('admin_disertante_listar') }}">
                                <i class="bi bi-people me-1"></i> Disertantes
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex">
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger px-4 rounded-pill shadow-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                        </a>
                    </div>

                </div>
            </div>
        </nav>

    {% endblock %}

    {% block messages %}

        <div style="padding-top: 60px;"></div>

        {% for mensaje in app.flashes('success') %}
        
            <div class="alert alert-success">
                {{ mensaje }}
            </div>
    
        {% endfor %}
    
    
        {% for mensaje in app.flashes('info') %}
    
            <div class="alert alert-info">
                {{ mensaje }}
            </div>
    
        {% endfor %}
    
        {% for mensaje in app.flashes('warning') %}
    
            <div class="alert alert-warning">
                {{ mensaje }}
            </div>
    
        {% endfor %}
    {% endblock %}