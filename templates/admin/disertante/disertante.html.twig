{% extends 'admin/layout-admin.html.twig' %}

{% block title %}Disertante{% endblock %}

{% block body %}
    <h1>Disertante</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ disertante.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ disertante.nombre }}</td>
            </tr>
            <tr>
                <th>Apellido</th>
                <td>{{ disertante.apellido }}</td>
            </tr>
            <tr>
                <th>Biografia</th>
                <td>{{ disertante.biografia }}</td>
            </tr>
            <tr>
                <th>Telefono</th>
                <td>{{ disertante.telefono }}</td>
            </tr>
            <tr>
                <th>Calle</th>
                <td>{{ disertante.direccion }}</td>
            </tr>
            <tr>
                <th>Url</th>
                <td>{{ disertante.url }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ disertante.email }}</td>
            </tr>
            <tr>
                <th>Twitter</th>
                <td>{{ disertante.twitter }}</td>
            </tr>
            <tr>
                <th>Linkedin</th>
                <td>{{ disertante.linkedin }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_disertante_listar') }}">Volver a la lista</a>

    <a href="{{ path('admin_disertante_editar', {'id': disertante.id}) }}">Editar</a>

    {{ include('admin/disertante/_delete_form.html.twig') }}
{% endblock %}
