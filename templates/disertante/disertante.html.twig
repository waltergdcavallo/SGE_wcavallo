{% extends 'frontend/layout.html.twig' %}

{% block title %}Disertante: {{ disertante.nombre }}{% endblock %}

{% block body %}
    <div class="container my-5">

        <div class="mb-4">
            <a href="{{ path('app_disertantes') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver a disertantes
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-4 p-md-5 mb-5">

                    <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                        <div class="bg-success bg-opacity-10 text-success p-4 rounded-circle fs-1 me-4">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <h1 class="display-6 fw-bold text-dark mb-2">
                                {{ disertante.nombreCompleto }}
                            </h1>

                            <div class="d-flex flex-wrap gap-3 text-muted small">
                                {% if disertante.telefono %}
                                    <span><i class="bi bi-telephone text-success me-1"></i> {{ disertante.telefono }}</span>
                                {% endif %}
                                {% if disertante.url %}
                                    <a href="{{ disertante.url }}" target="_blank" class="text-decoration-none text-primary">
                                        <i class="bi bi-globe me-1"></i> Sitio Web <i class="bi bi-box-arrow-up-right small"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h4 class="fw-bold text-dark mb-3"><i class="bi bi-file-text text-success me-2"></i> Biografía</h4>
                        <div class="text-muted fs-6 lh-lg">
                            {{ disertante.biografia|raw }}
                        </div>
                    </div>

                    <div>
                        <h4 class="fw-bold text-dark mb-4">
                            <i class="bi bi-calendar-check text-success me-2"></i> Eventos a su cargo
                        </h4>

                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            {% for evento in disertante.eventos %}
                                <div class="col">
                                    <div class="card border bg-light h-100 rounded-3 shadow-none p-3 position-relative">
                                        <div class="card-body">
                                            <h5 class="h6 fw-bold text-dark mb-2">
                                                <a href="{{ path('evento_detalle', {'slug': evento.slug}) }}" class="text-decoration-none text-dark stretched-link">
                                                    {{ evento.titulo|title }}
                                                </a>
                                            </h5>
                                            <span class="small text-muted">
                                                <i class="bi bi-calendar-event me-1"></i> {{ evento.fecha|date('d/m/Y') }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="col-12">
                                    <div class="p-4 bg-light rounded-3 text-center text-muted">
                                        <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>
                                        Este disertante no posee eventos asignados actualmente.
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
{% endblock %}